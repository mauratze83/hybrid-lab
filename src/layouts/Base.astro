---
import '../styles/global.css';
import { getActiveCategories } from '../lib/categories';
import { INSTAGRAM, INSTAGRAM_URL } from '../../site.config.mjs';
import InstaIcon from '../components/InstaIcon.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string; // Pfad zum Vorschaubild, z. B. /og/<slug>.png
}

const SITE = 'Hybrid Lab';
const { title, description = 'Laufen, Rad, Schwimmen – ehrliche Trainingserfahrungen und Ausrüstung für Hybrid-Athleten auf dem Weg zum Marathon und Triathlon.', type = 'website', image = '/og/default.png' } = Astro.props;
const ogUrl = new URL(image, Astro.site);
const fullTitle = title ? `${title} · ${SITE}` : `${SITE} – Training zwischen Marathon und Triathlon`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  ...(await getActiveCategories()).map((c) => ({ href: c.url, label: c.name })),
  { href: '/ueber', label: 'Über' },
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    <meta name="apple-mobile-web-app-title" content="Hybrid Lab" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? 'Hybrid Lab'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="theme-color" content="#14181f" />
    <meta name="p:domain_verify" content="57b6170fc6cbe0bd14e4e8dd014e5cf2" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/" aria-label="Hybrid Lab – Startseite"><img src="/brand/hybrid-lab-icon.svg" alt="" width="34" height="34" />Hybrid <span>Lab</span></a>
        <nav class="nav" aria-label="Hauptnavigation">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href || path.startsWith(n.href + '/') ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <a class="social" href={INSTAGRAM_URL} target="_blank" rel="noopener me" aria-label={`Hybrid Lab auf Instagram (@${INSTAGRAM})`} title={`@${INSTAGRAM} auf Instagram`}><InstaIcon size={20} /></a>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>© {new Date().getFullYear()} Hybrid Lab. Als Amazon-Partner verdiene ich an qualifizierten Verkäufen. Mit * markierte Links sind Affiliate-Links.</p>
        <div>
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener me">Instagram</a>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </div>
      </div>
    </footer>
  </body>
</html>
