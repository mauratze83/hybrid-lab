---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, getActiveCategories } from '../../lib/categories';

const posts = await getPosts();
const cats = await getActiveCategories();
---
<Base title="Alle Artikel" description="Alle Artikel von Hybrid Lab zu Laufen, Rad, Schwimmen, Triathlon, Ausrüstung und Ernährung.">
  <section class="hero hero-sm">
    <div class="eyebrow">Archiv</div>
    <h1>Alle Artikel</h1>
  </section>
  {cats.map((c) => (
    <section>
      <div class="section-head">
        <h2 class="section-title">{c.name}</h2>
        <a class="more" href={c.url}>Zur Kategorie →</a>
      </div>
      <div class="grid">
        {posts.filter((p) => p.data.category === c.name).map((p) => (
          <ArticleCard slug={p.id} title={p.data.title} description={p.data.description} category={p.data.category} date={p.data.date} />
        ))}
      </div>
    </section>
  ))}
</Base>
