---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('artikel', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = [...new Set(posts.map((p) => p.data.category))];
---
<Base>
  <section class="hero">
    <div class="eyebrow">Marathon · Triathlon · Ausrüstung</div>
    <h1>Training für Leute, die <mark>mehr als eine</mark> Sportart lieben.</h1>
    <p>Hybrid Lab ist mein Trainingslabor auf dem Weg vom Halbmarathon über den Marathon bis zum IRONMAN 70.3: was funktioniert, was nicht – und welche Ausrüstung sich wirklich lohnt.</p>
    <div class="pills">
      {categories.map((c) => <a class="pill" href={`/artikel#${c.toLowerCase()}`}>{c}</a>)}
    </div>
  </section>

  <h2 class="section-title">Neueste Artikel</h2>
  <div class="grid">
    {posts.slice(0, 6).map((p) => (
      <ArticleCard slug={p.id} title={p.data.title} description={p.data.description} category={p.data.category} date={p.data.date} />
    ))}
  </div>
</Base>
