---
import { INSTAGRAM, INSTAGRAM_URL } from '../../site.config.mjs';
import InstaIcon from './InstaIcon.astro';
---
<aside class="insta-box">
  <div class="insta-text">
    <span class="eyebrow">Auf Instagram</span>
    <p class="insta-title">Folg dem Experiment – Training, Daten und Rennen bis zum IRONMAN 70.3.</p>
  </div>
  <a class="insta-btn" href={INSTAGRAM_URL} target="_blank" rel="noopener me"><InstaIcon size={20} />@{INSTAGRAM}</a>
</aside>
