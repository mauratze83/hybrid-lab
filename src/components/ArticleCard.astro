---
import { catUrl } from '../lib/categories';
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  date: Date;
  featured?: boolean;
}
const { slug, title, description, category, date, featured = false } = Astro.props;
const fmt = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'short', year: 'numeric' });
---
<article class:list={['card', { 'card-featured': featured }]}>
  <div class="meta"><a class="tag" href={catUrl(category)}>{category}</a><time datetime={date.toISOString()}>{fmt.format(date)}</time></div>
  <h3><a class="card-link" href={`/artikel/${slug}`}>{title}</a></h3>
  <p>{description}</p>
  {featured && <span class="card-cta" aria-hidden="true">Weiterlesen →</span>}
</article>
